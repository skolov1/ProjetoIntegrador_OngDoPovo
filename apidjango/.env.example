# Copie para .env e ajuste os valores. NUNCA comite o .env.
#   cp .env.example .env

# --- Banco de dados ---
# Alinhe com o docker-compose.yml na raiz do projeto
DB_NAME=ongdb
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=localhost
DB_PORT=5432

# --- Django ---
# Gere uma chave real com: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Email ---
# console = imprime no terminal (dev). Para producao, use o SMTP real.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=contato@ongdopovo.com.br

# --- CORS ---
# Origens autorizadas a chamar a API. Para producao: DJANGO_CORS_ORIGIN_WHITELIST=https://ongdopovo.com.br
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
