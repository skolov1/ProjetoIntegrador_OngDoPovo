# Copie para .env e ajuste os valores. NUNCA comite o .env.
#   cp .env.example .env

# --- Banco de dados ---
# Alinhe com o docker-compose.yml na raiz do projeto
DB_NAME=ongdb
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=localhost
DB_PORT=5432

# --- Django ---
# Gere uma chave real com: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Email ---
# console = imprime no terminal (dev). Para producao, use o SMTP real.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=ongdopovo@outlook.com

# --- CORS ---
# Origens autorizadas a chamar a API. Para producao: DJANGO_CORS_ORIGIN_WHITELIST=https://ongdopovo.com.br
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Desenvolvimento x producao ---
# SEM DJANGO_DEBUG=True o Django roda como producao (exige DJANGO_SECRET_KEY de verdade).
# Por isso, em desenvolvimento, copie este arquivo para .env (cp .env.example .env).

# --- Producao (Render) ---
# Endereco unico do banco; quando definido, ignora DB_NAME/DB_USER/... acima.
#   DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require
# Quando o site estiver num dominio definitivo, suba o HSTS (ex.: 31536000 = 1 ano).
#   DJANGO_HSTS_SECONDS=0
# Primeira conta de administrador, criada no deploy (troque a senha depois).
#   DJANGO_SUPERUSER_USERNAME=...
#   DJANGO_SUPERUSER_EMAIL=...
#   DJANGO_SUPERUSER_PASSWORD=...
