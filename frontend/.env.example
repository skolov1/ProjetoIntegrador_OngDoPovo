# Copie para .env.local e ajuste. NUNCA comite o .env.local.
#   cp .env.example .env.local

# Somente variaveis com prefixo VITE_ sao expostas ao browser.
# Usada pelo axios em src/lib/api.ts e pelo Orval em orval.config.ts.
# Prefixo /api/v1 declarado AQUI e no SCHEMA_PATH_PREFIX do Django (settings.py).
# Se mudar, mude nos dois lugares.
VITE_API_URL=http://localhost:8000/api/v1

# Schema OpenAPI do Django, consumido pelo script "pnpm api:generate".
# Suba o backend antes de rodar o generate, senao ele falha.
VITE_API_SCHEMA_URL=http://localhost:8000/api/schema/?format=json
